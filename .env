# ════════════════════════════════════════════════════════════════
# 🤖 全栈 Agent 团队 Web UI 配置文件
# ════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# LLM 配置 (必需)
# ────────────────────────────────────────────────────────────────

# LLM API 密钥 (必填)
# 支持 OpenAI、Ollama、DeepSeek、智谱等兼容服务
LLM_API_KEY=none

# LLM 服务地址
# Ollama: http://localhost:11434/v1
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 智谱: https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=http://localhost:11434/v1

# LLM 模型名称
# Ollama: qwen-coder-8k, llama2, mistral 等
# OpenAI: gpt-4, gpt-3.5-turbo
# DeepSeek: deepseek-coder
# 智谱: glm-4, glm-3.5-turbo
LLM_MODEL=qwen-coder-8k

# ────────────────────────────────────────────────────────────────
# 流水线配置
# ────────────────────────────────────────────────────────────────

# 启用人工审核模式 (true/false)
# true  → PRD、架构、QA 环节需要人工审核
# false → 完全自动化,无需人工干预
HUMAN_IN_LOOP=true

# 项目输出目录
OUTPUT_DIR=./output

# 日志级别 (INFO / DEBUG / WARNING / ERROR)
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────────
# 项目启动配置
# ────────────────────────────────────────────────────────────────

# 生成完成后是否自动启动项目 (true/false)
# true  → QA 通过后自动 npm install + npm start
# false → 生成完成后显示"启动项目"按钮,需要手动点击
AUTO_RUN=true

# npm 启动端口
RUN_PORT=3000

# ────────────────────────────────────────────────────────────────
# LLM 调用参数 (可选,一般无需修改)
# ────────────────────────────────────────────────────────────────

# 生成代码的随机性 (0.0-1.0)
# 0.3  → 确定性强,代码生成稳定
# 0.7  → 随机性强,结果多样
# LLM_TEMPERATURE=0.3

# 单次 LLM 调用最大 token 数
# LLM_MAX_TOKENS=8000

# LLM 调用超时时间(秒)
# LLM_TIMEOUT=600

# JSON 解析失败时的重试次数
# LLM_MAX_RETRIES=3

# ════════════════════════════════════════════════════════════════
# 🚀 快速开始
# ════════════════════════════════════════════════════════════════

# 最小化配置 (快速体验):
# 1. 修改 LLM_API_KEY (根据你的 LLM 服务)
# 2. 修改 LLM_BASE_URL (根据你的 LLM 地址)
# 3. 修改 LLM_MODEL (根据你使用的模型)
# 4. 保存文件
# 5. python api.py
# 6. 浏览器访问 http://localhost:5000

# ════════════════════════════════════════════════════════════════
# 📋 配置示例
# ════════════════════════════════════════════════════════════════

# 示例 1: 本地 Ollama (推荐学习/演示)
# ────────────────────────────────────────
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen-coder-8k
# HUMAN_IN_LOOP=false
# AUTO_RUN=false

# 示例 2: OpenAI (生产环境)
# ────────────────────────────────────────
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4
# HUMAN_IN_LOOP=false
# AUTO_RUN=false

# 示例 3: 完全自动化 (批量生成)
# ────────────────────────────────────────
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen-coder-8k
# HUMAN_IN_LOOP=false
# AUTO_RUN=true

# 示例 4: 人工审核模式 (质量优先)
# ────────────────────────────────────────
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen-coder-8k
# HUMAN_IN_LOOP=true
# AUTO_RUN=false
